# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment files and credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.token
credentials.json
client_secrets.json

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Frontend dependencies and logs
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime runs and logs
backend/data/logs/*
!backend/data/logs/.gitkeep
backend/data/runs/*
!backend/data/runs/.gitkeep

# IDEs and system artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo
