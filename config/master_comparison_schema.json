{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterComparisonRecord",
  "description": "Standardized 26-column evaluation record schema for Yahoo Gemini Enterprise vs. Glean Web App comparison.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique evaluation run execution identifier."
    },
    "system": {
      "type": "string",
      "enum": ["Gemini_Enterprise", "Glean_Web"],
      "description": "Target search/RAG platform."
    },
    "model_id": {
      "type": "string",
      "description": "Model identifier (e.g. gemini-3.5-flash, gemini-3.1-pro, glean-default)."
    },
    "instruction_set": {
      "type": "string",
      "description": "System instructions set applied (Default vs Custom)."
    },
    "agent_id": {
      "type": "string",
      "description": "Discovery Engine Agent ID (e.g. core_assistant)."
    },
    "connectors_used": {
      "type": "string",
      "description": "Specific data store connector ID used during query retrieval."
    },
    "iteration": {
      "type": "integer",
      "description": "Repetition index within the evaluation scenario."
    },
    "query": {
      "type": "string",
      "description": "Evaluated natural language prompt."
    },
    "ground_truth": {
      "type": "string",
      "description": "Required factual answer for verification."
    },
    "response_text": {
      "type": "string",
      "description": "Candidate response text generated by the system."
    },
    "response_word_count": {
      "type": "integer",
      "description": "Word count of candidate answer."
    },
    "accuracy_pass": {
      "type": "boolean",
      "description": "Boolean factual ground-truth match."
    },
    "judge_pass": {
      "type": "boolean",
      "description": "Boolean LLM-as-a-Judge verdict."
    },
    "judge_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of the judge evaluation."
    },
    "judge_reasoning": {
      "type": "string",
      "description": "Narrative explanation of the judge evaluation verdict."
    },
    "ttft_sec": {
      "type": "number",
      "description": "Time to First Token in seconds."
    },
    "ttlt_sec": {
      "type": "number",
      "description": "Time to Last Token in seconds."
    },
    "has_required_source": {
      "type": "boolean",
      "description": "Whether the required Google Drive source document was cited."
    },
    "evidence_match": {
      "type": "boolean",
      "description": "Whether the response is grounded in verified enterprise evidence containing the required facts."
    },
    "total_sources_count": {
      "type": "integer",
      "description": "Total number of source citations returned."
    },
    "additional_sources_count": {
      "type": "integer",
      "description": "Count of non-required citations returned."
    },
    "source_urls": {
      "type": "string",
      "description": "Pipe-separated string of citation URLs."
    },
    "status_code": {
      "type": "integer",
      "description": "HTTP return status code."
    },
    "trace_id": {
      "type": "string",
      "description": "W3C OpenTelemetry trace ID."
    },
    "span_id": {
      "type": "string",
      "description": "W3C OpenTelemetry span ID."
    },
    "generation_speed_tps": {
      "type": "number",
      "description": "Generation speed in tokens/characters per second."
    },
    "error_message": {
      "type": "string",
      "description": "Error description if status code != 200."
    }
  },
  "required": [
    "run_id",
    "system",
    "model_id",
    "instruction_set",
    "agent_id",
    "connectors_used",
    "iteration",
    "query",
    "ground_truth",
    "response_text",
    "response_word_count",
    "accuracy_pass",
    "judge_pass",
    "judge_confidence",
    "judge_reasoning",
    "ttft_sec",
    "ttlt_sec",
    "has_required_source",
    "total_sources_count",
    "additional_sources_count",
    "source_urls",
    "status_code",
    "trace_id",
    "span_id",
    "generation_speed_tps",
    "error_message"
  ]
}
