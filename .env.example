# ==============================================================================
# Gemini Enterprise Evaluation & Benchmarking Harness (.env.example)
# ==============================================================================
# Copy this file to '.env' at the eval_harness root:
#   cp .env.example .env
# ==============================================================================

# Target Google Cloud Project ID hosting your Gemini Enterprise search engine
PROJECT_ID=

# Google Cloud Project Number
GCP_PROJECT_NUMBER=

# Regional location of Discovery Engine serving configs (typically 'global' or 'us')
LOCATION=global

# Collection ID in Discovery Engine (defaults to 'default_collection')
COLLECTION_ID=default_collection

# The Vertex Search Engine / App ID configured in Google Cloud console
ENGINE_ID=

# (Optional) Specific Assistant / Agent ID if routing queries via Dialogflow / Agent Builder
AGENT_ID=

# Active target connector in Discovery Engine (e.g. Google Drive, Jira, or Confluence)
CONNECTOR_COLLECTION_ID=

# Google GenAI SDK Vertex AI backend toggle flag
GOOGLE_GENAI_USE_VERTEXAI=True

# Evaluation Harness web studio UI port (FastAPI backend on port 8088 / 8095)
EVAL_HARNESS_PORT=8095

# Headless mode flag: 'true' for REST streamAssist evaluations, 'false' for Playwright browser mode
EVAL_HARNESS_OFFLINE=true

# Chrome DevTools Protocol port for local browser evaluation tunneling
LOCAL_TUNNELING_EVAL_PORT=9225

# Company / Organization Name (used in prompt persona and domain verification)
COMPANY_NAME=Enterprise

# Search Mode: "Vector" (direct semantic/vector datastore RAG) vs "streamAssist" (agentic planner + connector tools)
SEARCH_MODE=Vector

# Connector Mode: "AUTO" (dynamically detects ingested chunks vs federated metadata links),
# "INGESTED" (crawled/chunked datastores), or "FEDERATED" (live third-party search proxies like SharePoint, Jira, Confluence)
CONNECTOR_MODE=AUTO

# Search Result Mode: "AUTO", "CHUNKS" (for crawled datastores), or "DOCUMENTS" (for federated datastores)
SEARCH_RESULT_MODE=AUTO

# (Optional) BigQuery dataset ID for exporting 3-tier benchmark results
BIGQUERY_DATASET=ge_eval_benchmarks
